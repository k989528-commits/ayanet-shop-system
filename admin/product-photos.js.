
document.addEventListener("DOMContentLoaded", function () {
    const db = window.supabase.createClient(
        "https://jltadhukraspfdaxbvwo.supabase.co",
        "sb_publishable_tItrrAg_q9xSCskecgc5Jg_bJkxsOiu"
    );

    const form = document.getElementById("productForm");
    const products = document.getElementById("products");
    const message = document.getElementById("productMessage");

    if (!form || !products) return;

    // Create the photo chooser
    const photoLabel = document.createElement("label");
    photoLabel.textContent = "Product Photo (optional)";

    const photoInput = document.createElement("input");
    photoInput.type = "file";
    photoInput.accept = "image/jpeg,image/png,image/webp";
    photoInput.id = "productPhoto";

    const preview = document.createElement("img");
    preview.style.display = "none";
    preview.style.maxWidth = "160px";
    preview.style.maxHeight = "160px";
    preview.style.objectFit = "contain";

    photoInput.addEventListener("change", function () {
        const file = photoInput.files[0];

        if (!file) {
            preview.style.display = "none";
            return;
        }

        if (!["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
            alert("Choose a JPG, PNG or WEBP photo.");
            photoInput.value = "";
            return;
        }

        if (file.size > 5 * 1024 * 1024) {
            alert("Photo must be 5 MB or smaller.");
            photoInput.value = "";
            return;
        }

        preview.src = URL.createObjectURL(file);
        preview.style.display = "block";
    });

    const submitButton = form.querySelector('button[type="submit"]');

    form.insertBefore(photoLabel, submitButton);
    form.insertBefore(photoInput, submitButton);
    form.insertBefore(preview, submitButton);

    async function uploadPhoto(file) {
        const extension = {
            "image/jpeg": "jpg",
            "image/png": "png",
            "image/webp": "webp"
        }[file.type];

        if (!extension) {
            throw new Error("Unsupported photo format.");
        }

        const filename =
            Date.now() + "-" +
            Math.random().toString(36).slice(2) +
            "." + extension;

        const { error } = await db.storage
            .from("product-photos")
            .upload(filename, file, {
                contentType: file.type,
                upsert: false
            });

        if (error) throw error;

        const { data } = db.storage
            .from("product-photos")
            .getPublicUrl(filename);

        return data.publicUrl;
    }

    // Handle adding products with photos
    form.addEventListener("submit", async function (event) {
        event.preventDefault();
        event.stopImmediatePropagation();

        const name = document.getElementById("productName").value.trim();
        const description =
            document.getElementById("productDescription").value.trim();
        const costPrice =
            Number(document.getElementById("productCostPrice").value);
        const price =
            Number(document.getElementById("productPrice").value);
        const stock =
            Number(document.getElementById("productStock").value);

        if (
            !name ||
            !Number.isFinite(costPrice) ||
            !Number.isFinite(price) ||
            costPrice <= 0 ||
            price <= 0 ||
            stock < 0 ||
            !Number.isInteger(stock)
        ) {
            message.textContent = "Please enter valid product details.";
            return;
        }

        const file = photoInput.files[0];

        if (file && (
            !["image/jpeg", "image/png", "image/webp"].includes(file.type) ||
            file.size > 5 * 1024 * 1024
        )) {
            message.textContent = "Choose a valid photo of 5 MB or less.";
            return;
        }

        submitButton.disabled = true;
        message.textContent = "Saving product...";

        try {
            let imageUrl = null;

            if (file) {
                message.textContent = "Uploading product photo...";
                imageUrl = await uploadPhoto(file);
            }

            message.textContent = "Adding product...";

            const { error } = await db.from("products").insert([{
                name,
                description,
                cost_price: costPrice,
                price,
                stock,
                image_url: imageUrl
            }]);

            if (error) throw error;

            message.textContent = "Product and photo saved successfully!";
            form.reset();
            preview.removeAttribute("src");
            preview.style.display = "none";

            setTimeout(() => window.location.reload(), 1000);

        } catch (error) {
            message.textContent = "Could not save product: " + error.message;
        } finally {
            submitButton.disabled = false;
        }
    }, true);

    // Add photo previews and photo-change buttons to existing products
    async function addPhotoTools(card) {
        if (card.dataset.photoTools === "yes") return;

        const heading = card.querySelector("h3");
        if (!heading) return;

        const productName = heading.textContent.trim();

        const { data, error } = await db
            .from("products")
            .select("id,image_url")
            .eq("name", productName)
            .maybeSingle();

        if (error || !data || !card.isConnected) return;

        card.dataset.photoTools = "yes";

        if (data.image_url) {
            const image = document.createElement("img");
            image.src = data.image_url;
            image.alt = productName;
            image.style.maxWidth = "150px";
            image.style.maxHeight = "150px";
            image.style.objectFit = "contain";
            image.style.display = "block";
            image.style.marginBottom = "10px";
            card.insertBefore(image, card.firstChild);
        }

        const changeButton = document.createElement("button");
        changeButton.type = "button";
        changeButton.textContent =
            data.image_url ? "Change Product Photo" : "Add Product Photo";

        const changeInput = document.createElement("input");
        changeInput.type = "file";
        changeInput.accept = "image/jpeg,image/png,image/webp";
        changeInput.style.display = "none";

        changeButton.addEventListener("click", () => changeInput.click());

        changeInput.addEventListener("change", async function () {
            const file = changeInput.files[0];
            if (!file) return;

            if (
                !["image/jpeg", "image/png", "image/webp"].includes(file.type) ||
                file.size > 5 * 1024 * 1024
            ) {
                alert("Choose a JPG, PNG or WEBP photo of 5 MB or less.");
                changeInput.value = "";
                return;
            }

            changeButton.disabled = true;
            changeButton.textContent = "Uploading...";

            try {
                const imageUrl = await uploadPhoto(file);

                const { error: updateError } = await db
                    .from("products")
                    .update({ image_url: imageUrl })
                    .eq("id", data.id);

                if (updateError) throw updateError;

                alert("Product photo updated successfully!");
                window.location.reload();

            } catch (error) {
                alert("Photo update failed: " + error.message);
                changeButton.disabled = false;
                changeButton.textContent = "Try Again";
            }
        });

        card.append(changeButton, changeInput);
    }

    const observer = new MutationObserver(() => {
        products.querySelectorAll(".product-card").forEach(card => {
            addPhotoTools(card);
        });
    });

    observer.observe(products, { childList: true });

    products.querySelectorAll(".product-card").forEach(card => {
        addPhotoTools(card);
    });
});
